# Copia este archivo como .env y ajusta los valores. El archivo .env NUNCA se sube al repositorio.

# --- Seguridad ---
# Clave secreta usada para firmar sesiones y cookies. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Modo depuracion. En produccion debe ser False
DJANGO_DEBUG=True

# Hosts permitidos separados por coma
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Origenes protegidos por CSRF, solo necesario si la app se publica con https
DJANGO_CSRF_TRUSTED_ORIGINS=

# Longitud minima exigida a las contrasenas de los usuarios
DJANGO_PASSWORD_MIN_LENGTH=8

# --- Sesiones ---
# Vida maxima de la sesion en segundos (28800 = 8 horas de jornada)
DJANGO_SESSION_COOKIE_AGE=28800

# Minutos sin actividad antes de cerrar la sesion automaticamente
DJANGO_SESSION_INACTIVIDAD_MINUTOS=30

# Nombre de la cookie de sesion
DJANGO_SESSION_COOKIE_NAME=stockflow_sessionid

# --- Base de datos ---
# Motor por defecto. Opciones: django.db.backends.sqlite3 | django.db.backends.postgresql | django.db.backends.mysql
DJANGO_DB_ENGINE=django.db.backends.sqlite3

# Ruta o nombre del archivo cuando el motor es sqlite
DJANGO_DB_NAME=db.sqlite3

# Credenciales usadas solo si el motor NO es sqlite
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
DJANGO_DB_USER=stockflow
DJANGO_DB_PASSWORD=

# Segundos que se mantiene viva una conexion abierta (persistencia de conexiones)
DJANGO_DB_CONN_MAX_AGE=0
